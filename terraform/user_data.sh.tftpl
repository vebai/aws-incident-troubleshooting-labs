#!/bin/bash
set -euxo pipefail
exec > >(tee /var/log/shop-bootstrap.log | logger -t shop-bootstrap -s 2>/dev/console) 2>&1
dnf install -y python3 python3-pip iptables-nft
mkdir -p /opt/shop
python3 -m venv /opt/shop/venv
/opt/shop/venv/bin/pip install --no-cache-dir 'boto3>=1.34,<2'
echo '${shop_code}' | base64 -d > /opt/shop/shop_app.py
echo '${service_code}' | base64 -d > /etc/systemd/system/shop-app.service
printf 'SHOP_BUCKET=%s\n' '${bucket}' > /etc/shop-app.env
chmod 0644 /etc/shop-app.env
systemctl daemon-reload
systemctl enable --now shop-app
