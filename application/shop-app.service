[Unit]
Description=Shop incident laboratory service
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
EnvironmentFile=/etc/shop-app.env
ExecStart=/opt/shop/venv/bin/python /opt/shop/shop_app.py
Restart=on-failure
RestartSec=4
User=root
[Install]
WantedBy=multi-user.target
